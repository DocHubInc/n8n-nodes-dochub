      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1400, 0],
      "id": "c4a1e7b0-6d24-4f1a-9c31-0e5b8a7d1007",
      "name": "Mark sent"
    }
  ],
