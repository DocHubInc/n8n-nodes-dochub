{
    "name": "n8n-nodes-dochub",
    "version": "0.1.0",
    "description": "n8n community nodes for DocHub webhooks and document download",
    "license": "MIT",
    "homepage": "https://dev.dochub.com",
    "engines": {
        "node": ">=24"
    },
    "keywords": [
        "n8n-community-node-package"
    ],
    "author": {
        "name": "Siarhei Kisliak",
        "email": "kislak7@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kislak/n8n-nodes-dochub.git"
    },
   "scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --experimental-strip-types --test test/**/*.test.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/DocHubApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/DocHub/DocHub.node.js",
            "dist/nodes/DocHubTrigger/DocHubTrigger.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^21.1.0",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
